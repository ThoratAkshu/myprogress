# Copy to .env and fill in real values. Never commit .env.

# --- Core -------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-value
DEBUG=false
# Comma-separated host names the site answers to.
ALLOWED_HOSTS=myprogress.example.com
# Full origins (scheme + host) allowed to submit forms.
CSRF_TRUSTED_ORIGINS=https://myprogress.example.com
# The site's address, used for links in emails sent by scheduled jobs (weekly parent emails).
SITE_URL=https://myprogress.example.com
# Leave empty unless a separate frontend calls this site from another origin.
CORS_ALLOWED_ORIGINS=
# Set to true only behind a proxy you control (nginx) that overwrites X-Forwarded-For.
TRUST_X_FORWARDED_FOR=false
# Default color theme: midnight, ocean or emerald. ?theme= previews another for the session.
UI_THEME=midnight

# --- Database (PostgreSQL) --------------------------------------------------
DB_NAME=myprogress
DB_USER=myprogress
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432

# --- Storage ----------------------------------------------------------------
# Persistent disk paths. Back both up.
GIT_REPOSITORY_ROOT=/var/lib/myprogress/repositories
MEDIA_ROOT=/var/lib/myprogress/media
# Swap for an object-storage backend (for example django-storages) when you add one.
MEDIA_STORAGE_BACKEND=django.core.files.storage.FileSystemStorage

# --- Git hosting ------------------------------------------------------------
GIT_EXECUTABLE=git
# Largest single push accepted, in bytes (default 1 GiB).
GIT_MAX_REQUEST_BYTES=1073741824
# Seconds before a git request is stopped.
GIT_HTTP_TIMEOUT=600

# --- Learning studio AI ------------------------------------------------------
# Claude API key from https://console.anthropic.com. Leave empty to use the
# built-in starter drafts instead of AI-written ones.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Seconds to wait for a draft before giving up.
AI_TIMEOUT=90

# --- Creator payments (RazorpayX Payouts) -----------------------------------
# Leave empty to pay creators by hand and record each UTR in the finance console.
# With all four set, payment day sends money to each creator's UPI ID or bank.
# Webhook URL to add in RazorpayX: https://<your-domain>/finance/webhooks/razorpayx/
# (events: payout.processed, payout.reversed, payout.failed, payout.rejected).
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=

# --- Two-way video calls for live classes (optional) -------------------------
# Empty: classes without a meeting link are held inside MyProgress as a broadcast
# from the teaching board, with chat and raised hands; nothing else to run.
# For video calls where students can talk too, run your own Jitsi Meet server
# and put its host name here, for example meet.yourinstitute.in. meet.jit.si
# won't work (embedded calls end after 5 minutes). See docs/DEPLOYMENT.md.
JITSI_DOMAIN=
# Optional: if that server uses token authentication, its app_id and app_secret.
# Only signed-in members of the class can then enter the room.
JITSI_APP_ID=
JITSI_APP_SECRET=
# Largest class recording from the teaching board, in bytes (default 2 GB, about 2 hours at 720p).
CLASS_RECORDING_MAX_BYTES=2147483648
# Class reminders, scheduled posts, lectures and tasks also run as people use the site, at most
# this often (seconds). Set to 0 once cron runs run_organization_jobs every few minutes.
ORGANIZATION_JOBS_EVERY_SECONDS=60

# --- Cache / rate limits ----------------------------------------------------
# Required when running more than one app process, so rate limits are shared.
# For example redis://localhost:6379/0 (the redis package is in requirements.txt).
REDIS_URL=

# --- Email (verification and password reset) -------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=MyProgress <no-reply@myprogress.example.com>
